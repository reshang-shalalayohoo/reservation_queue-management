    subgraph Backend["backend/ Package (Node.js + Express API Server)"]
        direction TB
        CFG["config/\\ndb.js (MySQL Connection Pool)"]
        MW["middleware/\\nauth.js (JWT Auth & Role Guard)"]
        ROUTES["routes/ (8 REST Controllers)\\nauth.js · reservations.js · queue.js\\ntables.js · seating.js · menu.js\\norders.js · dashboard.js"]
        SOCK["socket/\\nindex.js (Real-Time Signal Broker)"]
        DB["database/\\nschema.sql · seed.js"]
        BE_ENTRY["Server Entry\\nserver.js · .env"]
    end

    PAGES -.->|"Imports & Consumes"| CTX
    PAGES -.->|"Dispatches HTTP"| SVC
    CTX -.->|"Sets Auth Token"| SVC
    SVC -->|"REST API (HTTP /api/*)"| ROUTES
    CTX <.->|"WebSocket Signals"| SOCK
    ROUTES -->|"Validates JWT & Roles"| MW
    ROUTES -->|"Executes SQL Queries"| CFG
    SOCK -->|"Authenticates Handshake"| MW
    CFG -->|"Defines Tables"| DB
