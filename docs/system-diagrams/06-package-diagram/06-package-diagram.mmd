graph TB
    subgraph Frontend["frontend/ Package (React.js + Vite Client)"]
        direction TB
        COMP["components/\\nNavbar.jsx · ProtectedRoute.jsx · EmptyState.jsx"]
        CTX["context/\\nAuthContext.jsx · CartContext.jsx · SocketContext.jsx"]
        subgraph PAGES["pages/"]
            direction TB
            P_AUTH["Login.jsx · Register.jsx"]
            P_CUST["customer/ (8 Views)\\nReservation · MyReservations · QueueStatus\\nDigitalMenu · MenuItemDetails · Cart\\nOrderConfirmation · OrderStatus"]
            P_STAFF["staff/ (5 Views)\\nReservationMgmt · ReservationDetails\\nQueueMgmt · TableMgmt · SeatingMgmt"]
